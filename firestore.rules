rules_version = '2';

// Pelote : chaque personne ne lit et n'écrit que ses propres données,
// rangées sous users/{uid}/…  Seules les adresses de ALLOWED peuvent se connecter.
service cloud.firestore {
  match /databases/{database}/documents {

    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'chris.depaola.toru@gmail.com'
        ];
    }

    function owner(uid) {
      return allowed() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if owner(uid);

      match /{collection}/{docId} {
        allow read, write: if owner(uid)
          && collection in ['tasks', 'thoughts', 'reminders', 'panier', 'states', 'knots'];
      }
    }

    // Tout le reste est fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
