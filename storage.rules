rules_version = '2';

// Images du Panier : users/{uid}/panier/{fichier}, images uniquement, 10 Mo max.
// Mêmes adresses autorisées que dans firestore.rules.
service firebase.storage {
  match /b/{bucket}/o {
    function owner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['chris.depaola.toru@gmail.com'];
    }
    match /users/{uid}/panier/{file} {
      allow read, delete: if owner(uid);
      allow create: if owner(uid)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
